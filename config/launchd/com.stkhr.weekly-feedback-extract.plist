<?xml version="1.0" encoding="UTF-8"?>
<!--
  weekly-feedback-extract を平日の夜に走らせる。__HOME__ は install.sh が置換する。

  Why not RunAtLoad: ログイン毎に走らせても、その日の作業がまだ終わっていない。

  スリープ中に発火時刻を跨いだ場合、launchd は復帰時に実行する。電源断でそれも
  逃した日は、スクリプト側のマーカーが未処理日として次回まとめて拾う。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stkhr.weekly-feedback-extract</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/weekly-feedback-extract</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/.claude/weekly-feedback/extract.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/weekly-feedback/extract.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
